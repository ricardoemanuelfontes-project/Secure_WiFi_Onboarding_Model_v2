<?xml version="1.0" encoding="utf-8"?>
<!-- Sem acesso à Internet. Permissões: esconder janelas de outras apps por cima desta
     (Android 12+, contra ataques de sobreposição) e a câmara, pedida só quando carregas em
     "Ler QR" (as imagens não são guardadas). A app funciona sem câmara. -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.HIDE_OVERLAY_WINDOWS" />
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-feature android:name="android.hardware.camera" android:required="false" />

    <application
        android:allowBackup="false"
        android:fullBackupContent="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="Reczi cypher"
        android:supportsRtl="true"
        android:theme="@style/Theme.Reczi">

        <activity
            android:name=".MainActivity"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboardHidden"
            android:exported="true"
            android:launchMode="singleTask"
            android:taskAffinity=""
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <!-- Recebe texto partilhado de outras apps (mensagens e chaves públicas). -->
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="text/plain" />
            </intent-filter>
        </activity>

        <!-- Limpa a área de transferência depois de copiar texto desencriptado. -->
        <receiver
            android:name=".ClipboardClearReceiver"
            android:exported="false" />
    </application>
</manifest>
